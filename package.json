{
  "name": "reachy-jev",
  "version": "0.0.1",
  "description": "Typed decision primitives for Reachy Mini apps",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "CITATION.cff"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "reachy-jev": "./bin/reachy-jev.mjs" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint:example": "npm run build && node bin/reachy-jev.mjs questions lint examples/attention-bank.json --people p1,p2",
    "example": "npm run build && node examples/room-decision.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": { "react": "^18.3.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdelStark/reachy-jev.git"
  },
  "keywords": [
    "reachy-mini",
    "robotics",
    "jev",
    "typed-decisions"
  ]
}
